---
import '../styles/global.css';
const { title = 'ENT Weekly' } = Astro.props;
const current = Astro.url.pathname;
const nav = [
  ['全部文献', '/'],
  ['主题分类', '/topics/'],
  ['周报', '/weekly/'],
];
const more = [['项目简介', '/project/'], ['更新日志', '/changelog/'], ['反馈', '/feedback/']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="耳鼻喉科高质量 PubMed 文献日追踪与周报" />
    <title>{title} · ENT Weekly</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23087f8c'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-size='36' font-weight='bold' fill='white'%3EE%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-mark">E</span><span class="brand-name">ENT Weekly</span></a>
        <p class="nav-label">文献阅读</p>
        <nav>{nav.map(([label, href]) => <a class:list={["nav-link", { active: current === href }]} href={href}>{label}</a>)}</nav>
        <p class="nav-label more-label">更多</p>
        <nav>{more.map(([label, href]) => <a class:list={["nav-link", { active: current === href }]} href={href}>{label}</a>)}</nav>
        <p class="sidebar-foot">ENT Weekly<br />文献追踪服务</p>
      </aside>
      <main>
        <header class="topbar"><b>耳鼻喉科Pubmed文献追踪</b><span>每日 14:00 同步</span></header>
        <slot />
        <footer class="site-footer">
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">粤ICP备2026138286号</a>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  .site-footer { padding: 0 50px 32px; color: var(--muted); font-size: .78rem; text-align: center; }
  .site-footer a:hover { color: var(--accent-strong); text-decoration: underline; }
  @media (max-width: 680px) { .site-footer { padding: 0 18px 24px; } }
</style>
