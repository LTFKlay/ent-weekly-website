---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/site';
export function getStaticPaths() { return []; }
const references = articles;
const cite = (pmid: string) => `<a class="cite" href="/article/${pmid}/">[${pmid}]</a>`;
---
<BaseLayout title="ENT 文献周报"><div class="page"><header class="report-head"><span class="eyebrow">Weekly review · 演示版</span><h1>ENT 文献周报</h1><p>2026.09.07 – 09.13</p><div class="stats"><span>本周纳入 <b>6</b> 篇</span><span>鼻科 <b>2</b></span><span>耳科 <b>1</b></span><span>咽喉科 <b>2</b></span><span>鼻咽癌 <b>1</b></span></div></header><div class="audit"><b>演示说明。</b>本页展示 DeepSeek 长篇自动综述的版式。生产模式下，内容只从通过 JCR/CAS 门禁的当期 PubMed 摘要生成，段落引文必须指向本期 PMID。</div><section class="report-section"><h2>一、检索与质量审计</h2><p>报告周：2026.09.07 – 09.13（Asia/Shanghai）。正式报告在此列出 EDAT 主列表、PDAT 回补、检索版本、候选数、各专科计数、质量门禁和排除统计。</p></section><section class="report-section"><h2>二、鼻科</h2><h3>临床研究与综述 Meta</h3><p set:html={`本期演示内容聚焦慢性鼻窦炎的长期管理与嗅觉上皮再生。真实综述会逐一说明研究设计、对象、结局和局限性；观察性信号不会作为临床推荐。${cite('DEMO-1001')} ${cite('DEMO-1005')}`}></p></section><section class="report-section"><h2>三、耳科</h2><h3>临床研究</h3><p set:html={`人工耳蜗植入术后言语识别结局需要结合基线情况与随访时间解读。若摘要未报告样本量或效应量，生产综述会明确写作“摘要未报告”。${cite('DEMO-1002')}`}></p></section><section class="report-section"><h2>四、咽喉科</h2><h3>基础研究与指南共识</h3><p set:html={`喉癌免疫微环境和早期口咽癌功能结局分属不同证据轨道，不能相互替代，也不能单独改变临床路径。${cite('DEMO-1003')} ${cite('DEMO-1006')}`}></p></section><section class="report-section"><h2>五、鼻咽癌</h2><h3>AI/ML</h3><p set:html={`循环 EBV DNA 风险分层的临床价值需结合验证队列、检测时点和阈值判断；站内文字只复述摘要支持的结论。${cite('DEMO-1004')}`}></p></section><section class="report-section"><h2>六、证据边界</h2><p>DeepSeek 只能归纳已纳入摘要，不能补充外部知识或形成诊疗建议。英文 PubMed 摘要优先；本周综述不构成临床指南。</p></section><section class="report-section"><h2>参考文献</h2>{references.map((article) => <div class="reference"><b>{article.pmid}</b> · {article.authors.join('；')} · {article.titleEn} · {article.journal} · <a href={`/article/${article.pmid}/`}>查看文献卡片</a></div>)}</section></div></BaseLayout>
