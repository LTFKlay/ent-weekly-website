---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const weeklyDir = process.env.WEEKLY_SNAPSHOT_DIR && fs.existsSync(process.env.WEEKLY_SNAPSHOT_DIR)
  ? process.env.WEEKLY_SNAPSHOT_DIR
  : path.resolve(process.cwd(), '../data/weekly');

export function getStaticPaths() {
  const directory = process.env.WEEKLY_SNAPSHOT_DIR && fs.existsSync(process.env.WEEKLY_SNAPSHOT_DIR)
    ? process.env.WEEKLY_SNAPSHOT_DIR
    : path.resolve(process.cwd(), '../data/weekly');
  if (!fs.existsSync(directory)) return [];
  return fs.readdirSync(directory)
    .filter((file) => /^weekly-\d{4}-\d{2}-\d{2}\.json$/.test(file))
    .map((file) => {
      const payload = JSON.parse(fs.readFileSync(path.join(directory, file), 'utf8'));
      return { params: { week: payload.summary.week_start }, props: { report: payload } };
    });
}

const { report } = Astro.props;
const specialtyLabels: Record<string, string> = {
  rhinology: '鼻科', otology: '耳科', laryngology: '咽喉科', nasopharyngeal_carcinoma: '鼻咽癌',
};
const categoryLabels: Record<string, string> = {
  clinical: '临床研究', ai_ml: 'AI/ML', basic: '基础研究', review_meta: '综述 Meta', guideline_consensus: '指南共识',
};
const specialtyOrder = ['rhinology', 'otology', 'laryngology', 'nasopharyngeal_carcinoma'];
const categoryOrder = ['clinical', 'ai_ml', 'basic', 'review_meta', 'guideline_consensus'];
const citationNumber = new Map(report.articles.map((article: any, index: number) => [String(article.pmid), index + 1]));
const escapeHtml = (value: string) => value
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
const citation = (pmid: string) => {
  const number = citationNumber.get(pmid);
  return number ? `<sup class="inline-citation"><a href="/article/${pmid}/" aria-label="查看文献 [${number}]">[${number}]</a></sup>` : pmid;
};
const removeContinuationLead = (value: string) => value.replace(/^本周[^。]{0,160}。\s*/, '');
const renderParagraph = (value: string, isContinuation: boolean) => escapeHtml(isContinuation ? removeContinuationLead(value) : value)
  .replace(/(?:[（(]\s*)?\[\[PMID:(\d{8})\]\](?:\s*[）)])?|(?:[（(]\s*)?(?:PMID\s*|PMID：)(\d{8})(?:\s*[）)])?|(?:[（(]\s*)?(?<!\d)(\d{8})(?!\d)(?:\s*[）)])?/gi, (_, tagged, labeled, plain) => citation(tagged || labeled || plain))
  .replace(/\n/g, '<br />');
const groupedSections = specialtyOrder.map((specialty) => ({
  specialty,
  categories: categoryOrder.map((category) => ({
    category,
    sections: report.summary.sections.filter((section: any) => section.specialty === specialty && section.display_category === category),
  })).filter((category) => category.sections.length),
})).filter((group) => group.categories.length);
const reportTitle = `${report.summary.week_start} – ${report.summary.week_end} 耳鼻喉文献周报`;
---

<BaseLayout title={reportTitle}>
  <div class="page weekly-report">
    <a class="back-link" href="/weekly/">← 返回历史周报</a>
    <header class="weekly-head">
      <span class="eyebrow">ENT WEEKLY REVIEW</span>
      <h1>{reportTitle}</h1>
      <p class="muted">本周收录 {report.audit.public_records} 篇</p>
    </header>

    <div class="report-layout">
      <aside class="weekly-toc" aria-label="周报专科目录">
        <span>本期目录</span>
        {groupedSections.map((group) => <a href={`#section-${group.specialty}`}>{specialtyLabels[group.specialty]}</a>)}
        <a href="#references">参考文献</a>
      </aside>

      <div class="report-body">
        {groupedSections.map((group) => <section id={`section-${group.specialty}`} class:list={['specialty-section', `specialty-${group.specialty}`]}>
          <header class="specialty-heading">{specialtyLabels[group.specialty]}</header>
          {group.categories.map((category) => <article class="evidence-block">
            <h2>{categoryLabels[category.category] || category.category}</h2>
            {category.sections.map((section: any, index: number) => <p set:html={renderParagraph(section.markdown, index > 0)}></p>)}
          </article>)}
        </section>)}

        <section id="references" class="references report-section">
          <h2>参考文献</h2>
          <p class="muted">点击编号可进入站内文献卡片。</p>
          {report.articles.map((article: any, index: number) => <div class="reference"><a class="reference-number" href={`/article/${article.pmid}/`}>[{index + 1}]</a><span>{article.authors?.[0] || '作者未报告'}．{article.classification?.title_zh || article.title_en}．<em>{article.journal}</em>．PMID {article.pmid}</span></div>)}
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelector('.weekly-toc')?.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link?.hash) return;
    const target = document.getElementById(link.hash.slice(1));
    if (!target) return;
    event.preventDefault();
    history.pushState(null, '', link.hash);
    window.scrollTo({ top: Math.max(0, window.scrollY + target.getBoundingClientRect().top - 88), behavior: 'instant' });
  });
</script>

<style>
  .weekly-report { max-width: 960px; }
  .weekly-head { padding: 8px 0 26px; border-bottom: 2px solid var(--accent); }
  .weekly-head h1 { max-width: 760px; margin: 8px 0; font-size: clamp(2rem, 4vw, 2.85rem); }
  .report-layout { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 28px; align-items: start; }
  .weekly-toc { position: sticky; top: 108px; display: grid; gap: 5px; padding-top: 40px; }
  .weekly-toc > span { margin-bottom: 5px; color: var(--muted); font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .weekly-toc a { padding: 7px 10px; border-left: 2px solid var(--line); color: var(--muted); font-size: .88rem; font-weight: 700; text-decoration: none; transition: border-color .18s ease, color .18s ease, background .18s ease; }
  .weekly-toc a:hover { border-left-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); color: var(--accent-strong); }
  .report-body { min-width: 0; }
  .specialty-section, .references { scroll-margin-top: 88px; }
  .specialty-section { margin: 40px 0; }
  .specialty-heading { margin-bottom: 18px; color: var(--accent-strong); font-size: 1.45rem; font-weight: 800; letter-spacing: -.03em; }
  .specialty-otology .specialty-heading { color: #236b91; }
  .specialty-laryngology .specialty-heading { color: #785f93; }
  .specialty-nasopharyngeal_carcinoma .specialty-heading { color: #a35a60; }
  .evidence-block { padding: 20px 0 19px; border-bottom: 1px solid var(--line); }
  .evidence-block h2 { margin-bottom: 9px; color: var(--ink); font-size: 1.02rem; }
  .evidence-block > p { margin: 0 0 14px; color: color-mix(in srgb, var(--ink) 89%, var(--muted)); font-size: .96rem; line-height: 2; }
  .evidence-block > p:last-child { margin-bottom: 0; }
  :global(.inline-citation) { margin-left: 2px; vertical-align: super; line-height: 0; }
  :global(.inline-citation a), .reference-number { color: var(--blue); font-size: .76em; font-weight: 800; text-decoration: none; }
  :global(.inline-citation a):hover, .reference-number:hover { text-decoration: underline; }
  .references { margin-top: 50px; }.references > h2 { padding-bottom: 10px; border-bottom: 2px solid var(--accent); }
  .reference { display: grid; grid-template-columns: 45px minmax(0, 1fr); gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .86rem; line-height: 1.65; }
  .reference-number { width: fit-content; margin: 0; font-size: .92rem; }.reference em { color: var(--ink); font-style: normal; }
  @media (max-width: 760px) { .weekly-head h1 { font-size: 1.8rem; }.report-layout { display: block; }.weekly-toc { position: static; display: flex; flex-wrap: wrap; gap: 7px; padding-top: 24px; }.weekly-toc > span { width: 100%; }.weekly-toc a { border: 1px solid var(--line); border-radius: 999px; }.evidence-block > p { font-size: .92rem; line-height: 1.9; } }
</style>
